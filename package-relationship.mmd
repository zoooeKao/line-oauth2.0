flowchart LR
    subgraph config["config 設定與組裝"]
        LineProperties["LineProperties<br/>(line.*)"]
        AppProperties["AppProperties<br/>(app.jwt.*)"]
        SecurityConfig["SecurityConfig<br/>(filter chain / CORS)"]
    end

    subgraph auth["auth OAuth 流程與安全"]
        AuthController["AuthController"]
        LineOAuthClient["LineOAuthClient"]
        JwtService["JwtService"]
        JwtAuthFilter["JwtAuthFilter"]
        LineProfile["LineProfile (DTO)"]
        LineTokenResponse["LineTokenResponse (DTO)"]
    end

    subgraph user["user 領域與持久化"]
        UserService["UserService"]
        UserRepository["UserRepository"]
        User["User (Entity)"]
    end

    %% config -> auth 注入設定
    LineProperties -->|注入| LineOAuthClient
    LineProperties -->|注入| AuthController
    AppProperties -->|注入 密鑰/效期| JwtService
    AppProperties -->|注入 frontendUrl| AuthController

    %% config 組裝 auth
    SecurityConfig -->|裝入 filter chain| JwtAuthFilter
    AppProperties -->|CORS 來源| SecurityConfig

    %% auth 內部
    AuthController -->|換 token / 抓 profile| LineOAuthClient
    AuthController -->|簽發 JWT| JwtService
    LineOAuthClient -->|回傳| LineTokenResponse
    LineOAuthClient -->|回傳| LineProfile

    %% auth -> user 主要業務依賴
    AuthController -->|upsert 使用者| UserService
    JwtAuthFilter -->|findById 查 User| UserRepository
    JwtService -->|讀 user.id| User

    %% user 內部
    UserService --> UserRepository
    UserRepository --> User

    %% user -> auth 反向耦合 (唯一)
    UserService -. 參數型別 LineProfile .-> LineProfile

    linkStyle 15 stroke:#d33,stroke-width:2px,color:#d33
